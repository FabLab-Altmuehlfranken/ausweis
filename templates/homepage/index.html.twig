{% extends 'base.html.twig' %}

{% block body %}
    <h1>Hallo {{ app.user.displayName }} 👋</h1>

    <p>
        {% if app.user.isMember %}
            Du bist aktuell Mitglied im FabLab Altmühlfranken. 🎉<br>
        {% else %}
            Du bist aktuell kein Mitglied im FabLab Altmühlfranken.<br>
            Wenn du das ändern möchtest findest du <a href="https://fablab-altmuehlfranken.de/mitglied-werden/" class="action">hier</a> den Mitgliedsantrag.<br>
        {% endif %}
    </p>

    <p>
        📱 Hier geht's zum
        <a href="{{ path('user_details_by_digital_card_id', {'uuid': app.user.digitalCardId}) }}">
            digitalen Ausweis
        </a>
        <br>
    </p>

    <p>
        🪪
        {% if app.user.cardId %}
            Deine physische Ausweiskarte hat die ID: <code>{{ app.user.cardId }}</code>
        {% elseif app.user.cardOrder %}
            {% if app.user.cardOrder.readyForPickUp %}
                Dein Ausweis ist bereit zur Abholung.
                Wende dich dazu am besten an einem OpenLab-Termin an ein Vorstandsmitglied.
            {% else %}
                Du hast bereits eine physische Ausweiskarte beantragt.
                Sobald dein Ausweis fertig ist, senden wir dir eine Mail an: <b>{{ app.user.mail }}</b>
            {% endif %}
        {% else %}
            Eine physische Ausweiskarte kannst du <a href="{{ path('order_card') }}" class="action">hier</a> beantragen.
        {% endif %}
    </p>
{% endblock %}
