{% extends 'base.html.twig' %}

{% block body %}
    <p>
        Ausweis-ID: <code>{{ user.digitalCardId }}</code>
    </p>

    <details class="qr-code">
        <summary>QR-Code anzeigen</summary>

        <img src="{{ qrCode.dataUri }}">
    </details>

    {% if is_granted('ROLE_ADMIN') %}
        <fieldset>
            <legend>Admin-Area</legend>

            Name: <b>{{ user.displayName }}</b>
            <br>
            Mitglied: {{ user.isMember ? '✅' : '❌' }}
            <br>
            Physischer Ausweis:
            {% if user.cardOrder %}
                {% if user.cardOrder.readyForPickUp %}
                    <a href="{{ path('deliver_card_order', {id: user.cardOrder.id}) }}">🤝 Ausweis aushändigen</a>
                {% elseif user.cardOrder.isPrintOrdered %}
                    <a href="{{ path('assign_card_id_to_order', {id: user.cardOrder.id}) }}">✏️ Ausweis zuordnen</a>
                {% else %}
                    ⏳ beantragt
                {% endif %}
            {% else %}
                {{ user.cardId ? '✅' : '❌' }}
            {% endif %}
        </fieldset>
    {% endif %}
{% endblock %}
