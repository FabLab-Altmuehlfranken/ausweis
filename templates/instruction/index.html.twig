{% extends 'base.html.twig' %}

{% block title %}Einweisungen{% endblock %}

{% block body %}
    <h1>🎓 Einweisungen</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
        {% for instruction in instructions %}
            <tr>
                <td>
                    <a href="{{ path('app_instruction_show', {'id': instruction.id}) }}">
                        {{ instruction.name }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_instruction_new') }}">➕ Neue Einweisung</a>
{% endblock %}
