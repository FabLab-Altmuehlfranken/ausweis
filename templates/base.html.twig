<!DOCTYPE html>
<html lang="de">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Ausweis - FabLab Altmühlfranken{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <link rel="icon" href="{{ asset('images/favicon.ico') }}">
        {% block stylesheets %}
            <style>
                body { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
            </style>
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
            <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
            <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.current_route !== 'hwi_oauth_connect' %}
            <header>
                <a href="{{ path('homepage') }}" class="logo">
                    <img src="{{ asset('images/logo.png') }}">
                    <span>Ausweis</span>
                </a>

                {% if is_granted('IS_AUTHENTICATED') %}
                    <a href="{{ logout_path() }}" class="logout">Ausloggen</a>
                {% endif %}
            </header>

            <nav>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('list_card_orders') }}">Ausweisanträge</a>
                    <a href="{{ path('app_area_index') }}">Berechtigungen</a>
                    <a href="{{ path('app_instruction_index') }}">Einweisungen</a>
                    <a href="{{ path('app_user_index') }}">Benutzer</a>
                {% endif %}
            </nav>

            <hr>
        {% endif %}

        {% for label, messages in app.flashes(['success', 'info', 'error']) %}
            {% for message in messages %}
                <p class="flash-{{ label }}">
                    {{ message|raw }}
                </p>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
