<form method="post" action="{{ path('app_privilege_delete', {'id': privilege.id}) }}" onsubmit="return confirm('Möchtest du die Berechtigung\n\'{{ privilege.area.name }}: {{ privilege.name }}\'\nwirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_privilege' ~ privilege.id) }}">
    <button class="btn">🗑 Löschen</button>
</form>
