<form method="post" action="{{ path('app_privilege_delete', {'id': privilege.id}) }}" onsubmit="return confirm('Möchtest du die Berechtigung \'{{ privilege.name }}\' wirklich löschen?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ privilege.id) }}">
    <button class="btn">Löschen</button>
</form>
