{% extends 'base.html.twig' %}

{% block title %}Berechtigung{% endblock %}

{% block body %}
    <h1>🔑 Berechtigung</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Bereich</th>
                <td>
                    <a href="{{ path('app_area_show', {'id': privilege.area.id}) }}">
                        {{ privilege.area.name }}
                    </a>
                </td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ privilege.name }}</td>
            </tr>
            <tr>
                <th>Beschreibung</th>
                <td>{{ privilege.description }}</td>
            </tr>
            <tr>
                <th>Zugewiesen an</th>
                <td>
                    <ul>
                        {% for assignment in privilege.privilegeAssignments %}
                            <li>
                                <a href="{{ path('user_details_by_digital_card_id', {'uuid': assignment.user.digitalCardId}) }}">
                                    {{ assignment.user.displayName }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_privilege_edit', {'id': privilege.id}) }}">✏️ Bearbeiten</a>

    {{ include('privilege/_delete_form.html.twig') }}
{% endblock %}
