{% extends 'base.html.twig' %}

{% block title %}Berechtigung{% endblock %}

{% block body %}
    <h1>Berechtigung</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Name</th>
                <td>{{ privilege.name }}</td>
            </tr>
            <tr>
                <th>Beschreibung</th>
