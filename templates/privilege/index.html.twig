{% extends 'base.html.twig' %}

{% block title %}Berechtigungen{% endblock %}

{% block body %}
    <h1>Berechtigungen</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Bereich</th>
                <th>Name</th>
                <th>Beschreibung</th>
            </tr>
        </thead>
        <tbody>
        {% for privilege in privileges %}
            <tr>
                <td>
                    <a href="{{ path('app_area_show', {'id': privilege.area.id}) }}">
                        {{ privilege.area.name }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('app_privilege_show', {'id': privilege.id}) }}">
                        {{ privilege.name }}
                    </a>
                </td>
                <td>{{ privilege.description }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_privilege_new') }}">➕ Neue Berechtigung</a>
{% endblock %}
