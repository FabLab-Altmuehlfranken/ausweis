{% extends 'base.html.twig' %}

{% block title %}Berechtigungen{% endblock %}

{% block body %}
    <h1>Berechtigungen</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Beschreibung</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for privilege in privileges %}
            <tr>
                <td>{{ privilege.name }}</td>
                <td>{{ privilege.description }}</td>
                <td>
                    <a href="{{ path('app_privilege_show', {'id': privilege.id}) }}">anzeigen</a>
                    <a href="{{ path('app_privilege_edit', {'id': privilege.id}) }}">bearbeiten</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_privilege_new') }}">Neue Berechtigung Anlegen</a>
{% endblock %}
