{% extends 'base.html.twig' %}

{% block title %}Bereiche{% endblock %}

{% block body %}
    <h1>Bereiche</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
            </tr>
        </thead>
        <tbody>
        {% for area in areas %}
            <tr>
                <td>
                    <a href="{{ path('app_area_show', {'id': area.id}) }}">
                        {{ area.name }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_area_new') }}">➕ Anlegen</a>
{% endblock %}
