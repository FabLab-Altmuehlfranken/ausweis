{% extends 'base.html.twig' %}

{% block title %}Bereich{% endblock %}

{% block body %}
    <h1>Bereich</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Name</th>
                <td>{{ area.name }}</td>
            </tr>
            <tr>
                <th>Berechtigungen</th>
                <td>
                    <ul>
                        {% for privilege in area.privileges %}
                            <li>
                                <a href="{{ path('app_privilege_show', {'id': privilege.id}) }}">
                                    {{ privilege.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_area_edit', {'id': area.id}) }}">✏️ Bearbeiten</a>

    {{ include('area/_delete_form.html.twig') }}
{% endblock %}
