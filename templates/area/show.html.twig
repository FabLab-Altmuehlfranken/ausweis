{% extends 'base.html.twig' %}

{% block title %}Bereich{% endblock %}

{% block body %}
    <h1>🛠️ Bereich</h1>

    <table>
        <tbody>
            <tr>
                <th>Name</th>
                <td>{{ area.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_area_edit', {'id': area.id}) }}" class="action">✏️ Bearbeiten</a>

    {{ include('area/_delete_form.html.twig') }}

    <h2>🔑 Berechtigungen</h2>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Beschreibung</th>
            </tr>
        </thead>
        <tbody>
            {% for privilege in area.privileges %}
                <tr>
                    <td>
                        <a href="{{ path('app_privilege_show', {'id': privilege.id}) }}">
                            {{ privilege.name }}
                        </a>
                    </td>
                    <td>{{ privilege.description }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_privilege_new', {'area': area.id}) }}" class="action">➕ Neue Berechtigung</a>
{% endblock %}
